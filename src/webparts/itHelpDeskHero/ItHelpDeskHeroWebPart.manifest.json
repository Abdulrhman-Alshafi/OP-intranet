          },
          {
            "title": "New devices are in stock",
            "linkText": "",
            "linkUrl": "https://example.com/devices",
            "imageUrl": "",
            "openInNewTab": false
          },
          {
            "title": "Download latest security update",
            "linkText": "",
            "linkUrl": "https://example.com/security",
            "imageUrl": "",
            "openInNewTab": false
          }
        ]
      }
    }
